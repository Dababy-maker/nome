        local function togglePicker(forcedState)
            if forcedState ~= nil then
                isOpen = forcedState
            else
                isOpen = not isOpen
            end

            local extraHeight = expandedHeight - collapsedHeight

            if isOpen then
                if windowRef and windowRef.openedPopups then
                    for _, popup in ipairs(windowRef.openedPopups) do
                        if popup.close and not popup.isColorPicker then popup.close() end
                    end
                end
                inlineContainer.Visible = true
                pf.ZIndex = 20
                sectionFrame.ZIndex = 15
                
                TweenService:Create(pf, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(1, 0, 0, expandedHeight)}):Play()
                local layout = sectionFrame:FindFirstChildOfClass("UIListLayout")
                sectionFrame.CanvasSize = UDim2.new(0, 0, 0, (layout and layout.AbsoluteContentSize.Y or 0) + extraHeight)
            else
                TweenService:Create(pf, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(1, 0, 0, collapsedHeight)}):Play()
                sectionFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
                task.delay(0.2, function()
                    if not isOpen then 
                        inlineContainer.Visible = false 
                        pf.ZIndex = 5
                        sectionFrame.ZIndex = 1
                    end
                end)
            end
        end

