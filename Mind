    function SectionAPI:AddSlider(options)
        options = options or {}
        local sliderText = options.Text or "Slider"
        local min = options.Min or 0
        local max = options.Max or 100
        local default = options.Default or min
        local callback = options.Callback or function() end

        local baseColor = Color3.fromRGB(65, 65, 65)
        local sliderFrame = create("Frame", {
            Name = sliderText .. "_SmallSlider",
            Size = UDim2.new(1, 0, 0, 35),
            BackgroundColor3 = baseColor,
            Parent = sectionFrame
        })

        if windowRef and windowRef.themeableBackgrounds then
            table.insert(windowRef.themeableBackgrounds, {Object = sliderFrame, BaseColor = baseColor})
        end

        create("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = sliderFrame })
        
        local sliderStroke = create("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 2, Parent = sliderFrame })
        local sliderGradient = create("UIGradient", {
            Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0.00, BORDER_COLOR), ColorSequenceKeypoint.new(0.30, BORDER_COLOR),
                ColorSequenceKeypoint.new(0.50, windowRef.CurrentThemeColor or themeCol), ColorSequenceKeypoint.new(0.70, BORDER_COLOR),
                ColorSequenceKeypoint.new(1.00, BORDER_COLOR)
            }),
            Rotation = 0, Parent = sliderStroke
        })

        if windowRef and windowRef.animatedGradients then 
            table.insert(windowRef.animatedGradients, sliderGradient) 
        end

        local state = create("NumberValue", { Name = "State", Value = default, Parent = sliderFrame })

        local label = create("TextLabel", {
            Name = "Label", Position = UDim2.new(0, 10, 0, 2), Size = UDim2.new(1, -20, 0, 15),
            BackgroundTransparency = 1, Font = Enum.Font.SourceSansBold,
            TextColor3 = Color3.fromRGB(225, 225, 225), TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Parent = sliderFrame
        })
        registerLocal(windowRef, label, sliderText)

        local valueLabel = create("TextBox", {
            Name = "Value", Position = UDim2.new(0, 10, 0, 2), Size = UDim2.new(1, -28, 0, 15),
            BackgroundTransparency = 1, Font = Enum.Font.SourceSansBold, Text = tostring(default),
            TextColor3 = Color3.fromRGB(200, 200, 200), TextSize = 13, TextXAlignment = Enum.TextXAlignment.Right, 
            ClearTextOnFocus = false, Parent = sliderFrame
        })

        local track = create("Frame", {
            Name = "Track", Position = UDim2.new(0, 10, 0, 20), Size = UDim2.new(1, -20, 0, 6),
            BackgroundColor3 = Color3.fromRGB(45, 45, 45), Parent = sliderFrame
        })
        create("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = track })
        create("UIStroke", { Color = BORDER_COLOR, Thickness = 1.5, Parent = track })

        local range = max - min
        if range == 0 then range = 1 end

        local fill = create("Frame", { Name = "Fill", Size = UDim2.new((default - min) / range, 0, 1, 0), BackgroundColor3 = windowRef.CurrentThemeColor or themeCol, Parent = track })
        create("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = fill })
        
        if windowRef and windowRef.staticThemeElements then
            table.insert(windowRef.staticThemeElements, {Object = fill, Property = "BackgroundColor3"})
        end

        local knob = create("Frame", { Name = "Knob", Size = UDim2.fromOffset(10, 10), Position = UDim2.new((default - min) / range, 0, 0.5, 0), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.fromRGB(225, 225, 225), Parent = track, ZIndex = 2 })
        create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = knob })

        local function updateSlider(inputObject)
            local x = math.clamp(inputObject.Position.X - track.AbsolutePosition.X, 0, track.AbsoluteSize.X)
            local percent = x / track.AbsoluteSize.X
            local value = math.floor((min + (max - min) * percent) + 0.5)
            state.Value = value
            valueLabel.Text = tostring(value)
            
            fill:TweenSize(UDim2.new(percent, 0, 1, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Sine, 0.05, true)
            knob:TweenPosition(UDim2.new(percent, 0, 0.5, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Sine, 0.05, true)
            
            if callback then callback(value) end
        end

        valueLabel.FocusLost:Connect(function()
            local num = tonumber(valueLabel.Text)
            if num then
                local clamped = math.clamp(math.floor(num + 0.5), min, max)
                local percent = (clamped - min) / range
                state.Value = clamped
                valueLabel.Text = tostring(clamped)
                
                fill:TweenSize(UDim2.new(percent, 0, 1, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Sine, 0.05, true)
                knob:TweenPosition(UDim2.new(percent, 0, 0.5, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Sine, 0.05, true)
                
                if callback then callback(clamped) end
            else
                valueLabel.Text = tostring(state.Value)
            end
        end)

        local interactionFrame = create("TextButton", { BackgroundTransparency = 1, Text = "", Size = UDim2.new(1, 10, 1, 10), Position = UDim2.new(0, -5, 0, -5), Parent = track })

        interactionFrame.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                local inputChanged, inputEnded
                updateSlider(input)
                inputChanged = UserInputService.InputChanged:Connect(function(io)
                    if io.UserInputType == Enum.UserInputType.MouseMovement or io.UserInputType == Enum.UserInputType.Touch then updateSlider(io) end
                end)
                inputEnded = UserInputService.InputEnded:Connect(function(io)
                    if io.UserInputType == Enum.UserInputType.MouseButton1 or io.UserInputType == Enum.UserInputType.Touch then
                        inputChanged:Disconnect(); inputEnded:Disconnect()
                    end
                end)
            end
        end)

        return sliderFrame
    end

