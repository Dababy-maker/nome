function RYZA:AddTab(tabName)
    if self.activeTab then
        if self.window and self.window.openedPopups then
            for _, popup in ipairs(self.window.openedPopups) do
                popup.close()
            end
        end
        local oldTabBaseColor = self.activeTab:GetAttribute("BaseColor")
        if oldTabBaseColor then
            local currentThemeColor = RYZA.Themes[self:GetThemeName()] or RYZA.Themes["Electric Purple"]
            self.activeTab.BackgroundColor3 = oldTabBaseColor:Lerp(currentThemeColor, 0.15)
        end
    end

    local baseColor = Color3.fromRGB(65, 65, 65)
    local tabButton = create("TextButton", { Name = tabName, Size = UDim2.fromOffset(94, 28), BackgroundColor3 = baseColor, Font = Enum.Font.SourceSansBold, TextColor3 = Color3.fromRGB(225, 225, 225), TextSize = 14, Parent = self.TabContainer })
    registerLocal(self.window or self, tabButton, tabName)
    
    tabButton:SetAttribute("BaseColor", baseColor)
    table.insert(self.themeableBackgrounds, {Object = tabButton, BaseColor = baseColor})

    create("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = tabButton })
    local tabStroke = create("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = tabButton })
    local tabGradient = create("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0.00, BORDER_COLOR),
            ColorSequenceKeypoint.new(0.30, BORDER_COLOR),
            ColorSequenceKeypoint.new(0.50, self.CurrentThemeColor),
            ColorSequenceKeypoint.new(0.70, BORDER_COLOR),
            ColorSequenceKeypoint.new(1.00, BORDER_COLOR)
        }),
        Rotation = 0, Parent = tabStroke
    })
    table.insert(self.animatedGradients, tabGradient)

    local contentPage = create("Frame", { Name = tabName .. "_Page", Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Parent = self.ContentContainer, Visible = false })
    
    local itemsContainer = create("Frame", {
        Name = "ItemsContainer",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Parent = contentPage
    })
    
    local listLayout = create("UIListLayout", { Parent = itemsContainer, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Left })
    
    local tabObject = {
        page = contentPage,
        ElementContainer = itemsContainer, 
        window = self,
        isTab = true,
        pages = {},
        pageStack = {},
        tabName = tabName,
        activeTabButton = tabButton,
        SectionCursors = {
            ["left"] = 2,
            ["right"] = 2
        },
        MaxSectionHeight = 0
    }
    tabObject.rootPage = tabObject
    setmetatable(tabObject, RYZA)
    table.insert(tabObject.pageStack, tabObject)
    
    local contentPadding = self.ContentContainer:FindFirstChildOfClass("UIPadding")

    listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        if tabObject.page.Visible then
            local h = math.max(listLayout.AbsoluteContentSize.Y, tabObject.MaxSectionHeight)
            self.ContentContainer.CanvasSize = UDim2.fromOffset(0, h + contentPadding.PaddingTop.Offset + contentPadding.PaddingBottom.Offset)
        end
    end)
    
    if not self.activeTab then
        contentPage.Visible = true
        self.activeTab = tabButton
    end
    
    self.pages[tabButton] = tabObject

    local currentThemeName = self:GetThemeName()
    if tabButton == self.activeTab then
        local currentThemeColor = RYZA.Themes[currentThemeName] or RYZA.Themes["Electric Purple"]
        tabButton.BackgroundColor3 = baseColor:Lerp(currentThemeColor, 0.35)
    end

    tabButton.MouseButton1Click:Connect(function()
        if self.activeTab and self.activeTab ~= tabButton then
            local winRef = self.window or self
            if winRef.openedPopups then
                for _, popup in ipairs(winRef.openedPopups) do
                    popup.close()
                end
            end
           
            local oldTab = self.pages[self.activeTab]
            if oldTab then
                oldTab.page.Visible = false
            end
           
            local oldTabBaseColor = self.activeTab:GetAttribute("BaseColor")
            local currentThemeName = self:GetThemeName()
            if oldTabBaseColor then
                local currentThemeColor = RYZA.Themes[currentThemeName] or RYZA.Themes["Electric Purple"]
                self.activeTab.BackgroundColor3 = oldTabBaseColor:Lerp(currentThemeColor, 0.15)
            end
        end

        tabObject.page.Visible = true
        local currentThemeName = self:GetThemeName()
        local currentThemeColor = RYZA.Themes[currentThemeName] or RYZA.Themes["Electric Purple"]
        tabButton.BackgroundColor3 = baseColor:Lerp(currentThemeColor, 0.35)
        self.activeTab = tabButton
        
        local h = math.max(listLayout.AbsoluteContentSize.Y, tabObject.MaxSectionHeight)
        self.ContentContainer.CanvasSize = UDim2.fromOffset(0, h + contentPadding.PaddingTop.Offset + contentPadding.PaddingBottom.Offset)
    end)
    return tabObject
end

function RYZA:SetLanguage(lang)
    self.CurrentLanguage = lang
    local langCode = (lang == "Spanish") and "es" or "en"
    
    if self.window and self.window.LocalizedElements then
        for _, item in ipairs(self.window.LocalizedElements) do
            if item.Element and item.Element.Parent then
                if self.Translations[lang] and self.Translations[lang][item.Key] then
                    item.Element[item.Property] = self.Translations[lang][item.Key]
                else
                    if lang == "English" then
                        item.Element[item.Property] = item.Key
                    else
                        task.spawn(function()
                            local requestFunc = syn and syn.request or http and http.request or http_request or fluxus and fluxus.request or getgenv().request or request
                            if requestFunc then
                                local url = "https://translate.googleapis.com/translate_a/single?client=gtx&sl=auto&tl="..langCode.."&dt=t&q=" .. urlEncode(item.Key)
                                local success, res = pcall(function() return requestFunc({Url = url, Method = "GET"}) end)
                                
                                if success and res and res.Body then
                                    local decSuccess, decoded = pcall(function() return HttpService:JSONDecode(res.Body) end)
                                    if decSuccess and decoded and decoded[1] and decoded[1][1] and decoded[1][1][1] then
                                        local translatedText = decoded[1][1][1]
                                        
                                        if not self.Translations[lang] then self.Translations[lang] = {} end
                                        self.Translations[lang][item.Key] = translatedText
                                        
                                        item.Element[item.Property] = translatedText
                                    end
                                end
                            end
                        end)
                    end
                end
            end
        end
    end
end

function RYZA:GetThemeName()
    return self.CurrentThemeName or "Electric Purple"
end

function RYZA:SetTheme(colorName)
    local themeColor = RYZA.Themes[colorName]
    if not themeColor then 
        themeColor = RYZA.Themes["Electric Purple"] 
    end

    self.CurrentThemeName = colorName
    self.CurrentThemeColor = themeColor

    local newColorSequence = ColorSequence.new({
        ColorSequenceKeypoint.new(0.00, BORDER_COLOR),
        ColorSequenceKeypoint.new(0.30, BORDER_COLOR),
        ColorSequenceKeypoint.new(0.50, themeColor),
        ColorSequenceKeypoint.new(0.70, BORDER_COLOR),
        ColorSequenceKeypoint.new(1.00, BORDER_COLOR)
    })

    for i = #self.animatedGradients, 1, -1 do
        local gradient = self.animatedGradients[i]
        if gradient and gradient.Parent then gradient.Color = newColorSequence else table.remove(self.animatedGradients, i) end
    end

    for i = #self.staticThemeElements, 1, -1 do
        local elementInfo = self.staticThemeElements[i]
        if elementInfo and elementInfo.Object and elementInfo.Object.Parent then elementInfo.Object[elementInfo.Property] = themeColor else table.remove(self.staticThemeElements, i) end
    end

    for i = #self.themeableBackgrounds, 1, -1 do
        local elementInfo = self.themeableBackgrounds[i]
        if elementInfo and elementInfo.Object and elementInfo.Object.Parent then
            if elementInfo.Object == self.activeTab then
                elementInfo.Object.BackgroundColor3 = elementInfo.BaseColor:Lerp(themeColor, 0.35)
            else
                elementInfo.Object.BackgroundColor3 = elementInfo.BaseColor:Lerp(themeColor, 0.15)
            end
        else
            table.remove(self.themeableBackgrounds, i)
        end
    end
end

function RYZA:UpdateVisuals()
    local tweenInfo = TweenInfo.new(0.3)

    if self.isOpaque then
        TweenService:Create(self.MainFrame, tweenInfo, {BackgroundTransparency = 0}):Play()
        local bg = self.MainFrame:FindFirstChild("BackgroundImage")
        if bg then TweenService:Create(bg, tweenInfo, {ImageTransparency = 0}):Play() end
    else
        TweenService:Create(self.MainFrame, tweenInfo, {BackgroundTransparency = self.defaultTransparency}):Play()
        local bg = self.MainFrame:FindFirstChild("BackgroundImage")
        if bg then TweenService:Create(bg, tweenInfo, {ImageTransparency = self.defaultTransparency}):Play() end
    end
end

function RYZA:SetBackground(bgName)
    self.CurrentBackground = bgName
    local assetId = RYZA.Backgrounds[bgName] or ""
    
    local existingBg = self.MainFrame:FindFirstChild("BackgroundImage")
    
    if assetId == "" then
        if existingBg then existingBg:Destroy() end
    else
        if not existingBg then
            existingBg = create("ImageLabel", {
                Name = "BackgroundImage",
                Size = UDim2.fromScale(1, 1),
                Position = UDim2.fromScale(0, 0),
                BackgroundTransparency = 1,
                ZIndex = 0,
                ScaleType = Enum.ScaleType.Stretch,
                ImageTransparency = self.isOpaque and 0 or self.defaultTransparency,
                Parent = self.MainFrame
            })
            create("UICorner", { CornerRadius = UDim.new(0, 16), Parent = existingBg })
        end
        existingBg.Image = assetId
    end
end

function RYZA:SetTransparency(level) 
    self.defaultTransparency = 1 - (level / 100)
    self:UpdateVisuals()
end

function RYZA:ResetSettings()
    local resetTheme = self.DefaultTheme or "Electric Purple"
    self:SetTheme(resetTheme)
    
    local resetTransparency = self.window.initialTransparencyValue or 75
    self:SetTransparency(resetTransparency)
    self.isOpaque = false

    if self.themeDropdown then self.themeDropdown.State.Value = resetTheme end
    if self.opacityToggle then self.opacityToggle.State.Value = false end
    if self.transparencySlider then self.transparencySlider.State.Value = resetTransparency end
    if self.bgDropdown then self.bgDropdown.State.Value = "None" end
    if self.languageDropdown then 
        self.languageDropdown.State.Value = "English" 
        self:SetLanguage("English")
    end
    
    self:SetBackground("None")
end

function RYZA:CreateSettingsTab(options)
    options = options or {}
    local settingsTab = self:AddTab("Settings")
    
    local visualSection = settingsTab:AddSmallSection({
        Text = "Visuals",
        Side = "Left"
    })

    local themeNames = {}
    for name in pairs(RYZA.Themes) do table.insert(themeNames, name) end
    table.sort(themeNames)

    local bgNames = {"None"}
    local tempBgs = {}
    for name in pairs(RYZA.Backgrounds) do if name ~= "None" then table.insert(tempBgs, name) end end
    table.sort(tempBgs)
    for _, name in ipairs(tempBgs) do table.insert(bgNames, name) end

    self.themeDropdown = visualSection:AddDropdown({
        Text = "Theme",
        Options = themeNames,
        Callback = function(v) self:SetTheme(v) end
    })

    self.bgDropdown = visualSection:AddDropdown({
        Text = "Background",
        Options = bgNames,
        Default = "None",
        Callback = function(v) self:SetBackground(v) end
    })

    self.transparencySlider = visualSection:AddSlider({
        Text = "Transparency", Min = 0, Max = 100, Default = 75,
        Callback = function(v) self:SetTransparency(v) end
    })

    self.opacityToggle = visualSection:AddToggle("Opaque Mode", function(v)
        self.isOpaque = v
        self:UpdateVisuals()
    end)
    
    visualSection:AddButton("Reset All", function()
        self:ResetSettings()
        RYZA.CreateNotification("Config", "Settings Reset", 2)
    end)

    local generalSection = settingsTab:AddSmallSection({
        Text = "General",
        Side = "Right"
    })

    self.languageDropdown = generalSection:AddDropdown({
        Text = "Language",
        Options = {"English", "Spanish"},
        Default = "English",
        Callback = function(v)
            self:SetLanguage(v)
            RYZA.CreateNotification("Language Changed", "Set to " .. v, 3)
        end
    })

    generalSection:AddButton("Join Discord", function()
        local discordLink = "https://discord.gg/ryza"
        SetClipboard(discordLink)
        RYZA.CreateNotification("Discord", "Link copied to clipboard!", 3)
    end)

    return settingsTab
end

