        local h, s, v = 0, 1, 1
        local workingColor = def

        local function updateWorkingColor()
            workingColor = Color3.fromHSV(h, s, v)
            svKnob.BackgroundColor3 = workingColor
            svBox.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
            local r = math.floor(workingColor.R * 255); local g = math.floor(workingColor.G * 255); local b = math.floor(workingColor.B * 255)
            rgbLabel.Text = string.format("R: %d  G: %d  B: %d", r, g, b)
            
            state.Value = workingColor
            colorPreview.BackgroundColor3 = workingColor
            if cb then cb(workingColor) end
        end
        
        local function setPickerToColor(col)
            local dh, ds, dv = col:ToHSV()
            h, s, v = dh, ds, dv
            workingColor = col
            local maxX = svBox.AbsoluteSize.X - 10
            local maxY = svBox.AbsoluteSize.Y - 10
            local xOffset = math.clamp(s * svBox.AbsoluteSize.X, 0, maxX)
            local yOffset = math.clamp((1 - v) * svBox.AbsoluteSize.Y, 0, maxY)
            svKnob.Position = UDim2.fromOffset(xOffset, yOffset)
            hueKnob.Position = UDim2.fromScale(h, 0.5)
            updateWorkingColor()
        end

