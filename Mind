            Font = Enum.Font.SourceSansBold,
            Parent = statusFrame
        })

        task.spawn(function()
            while statusFrame.Parent do
                local success, result, color = pcall(updateFunc)
                
                if success then
                    valueLabel.Text = tostring(result)
                    if color and typeof(color) == "Color3" then
                        valueLabel.TextColor3 = color
                    else
                        local lowerRes = tostring(result):lower()
                        if lowerRes == "open" or lowerRes == "true" or lowerRes == "yes" or lowerRes == "safe" then
                            valueLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
                        elseif lowerRes == "closed" or lowerRes == "false" or lowerRes == "no" or lowerRes == "unsafe" then
                            valueLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
                        else
                            valueLabel.TextColor3 = Color3.fromRGB(225, 225, 225)
                        end
                    end
                else
                    warn("RYZA LiveStatus Error:", result)
                    valueLabel.Text = "Script Error"
                    valueLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
                end
                task.wait(pollTime)
            end
        end)
        
        return statusFrame
    end
    
