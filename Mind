function RYZA.CreateNotification(titleText, contentText, duration)
    if not NotificationContainer or not NotificationContainer.Parent then
        InitializeNotificationUI()
    end
    duration = duration or 5
    
    local holder = create("Frame", {
        Name = "NotifHolder",
        Parent = NotificationContainer,
        Size = UDim2.fromOffset(220, 55),
        BackgroundTransparency = 1,
        LayoutOrder = -tick(),
        ClipsDescendants = false
    })

    local notifClone = NotificationTemplate:Clone()
    
    local lang = RYZA.CurrentLanguage or "English"
    notifClone.Title.Text = RYZA.Translations[lang] and RYZA.Translations[lang][titleText] or titleText
    notifClone.Content.Text = RYZA.Translations[lang] and RYZA.Translations[lang][contentText] or contentText
    
    notifClone.Parent = holder
    
    notifClone.Position = UDim2.new(1.5, 0, 0, 0) 
    TweenService:Create(notifClone, TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
        Position = UDim2.new(0, 0, 0, 0)
    }):Play()

    task.spawn(function()
        task.wait(duration)
        local tweenOut = TweenService:Create(notifClone, TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
            Position = UDim2.new(1.5, 0, 0, 0)
        })
        tweenOut:Play()
        tweenOut.Completed:Wait()
        holder:Destroy()
    end)
end

local function CreateSection(self, options, sectionHeight)
    options = options or {}
    local text = options.Text or "Section"
    local windowRef = self.window or self
    
    local SECTION_WIDTH = 191 
    local SECTION_HEIGHT = sectionHeight or 180
    local GAP = 5  
    
    local START_Y = 2 
    local LEFT_X = 0        
    local RIGHT_X = 197 

    local targetParent = options.Parent or self.page
    
    local side = options.Side
    if type(side) == "string" then side = side:lower() end
    if side ~= "left" and side ~= "right" then side = "left" end

    if not self.SectionCursors then
        self.SectionCursors = {
            ["left"] = START_Y,
            ["right"] = START_Y
        }
    end

    local currentY = self.SectionCursors[side]
    local currentX = (side == "left") and LEFT_X or RIGHT_X
    
    local finalPosition = options.Position
    if not finalPosition then
        finalPosition = UDim2.new(0, currentX, 0, currentY)
        self.SectionCursors[side] = currentY + SECTION_HEIGHT + GAP
        local maxCursor = math.max(self.SectionCursors["left"], self.SectionCursors["right"])
        self.MaxSectionHeight = maxCursor + 20
        if self.window and self.window.activeTab == self.activeTabButton then
            self.window.ContentContainer.CanvasSize = UDim2.fromOffset(0, self.MaxSectionHeight)
        end
    end

    local finalSize = UDim2.fromOffset(SECTION_WIDTH, SECTION_HEIGHT)

    local sectionFrame = create("ScrollingFrame", {
        Name = "Section_" .. side,
        Size = finalSize, 
        Position = finalPosition, 
        BackgroundColor3 = Color3.fromRGB(35, 35, 35),
        BackgroundTransparency = 0.5,
        BorderSizePixel = 0,
        ScrollBarThickness = 2,
        ScrollBarImageTransparency = 0.5,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        ClipsDescendants = true,
        Parent = targetParent
    })
    
    create("UICorner", { CornerRadius = UDim.new(0, 8), Parent = sectionFrame })
    
    local themeCol = Color3.fromRGB(200, 50, 255) 
    if windowRef and windowRef.CurrentThemeColor then
        themeCol = windowRef.CurrentThemeColor
    end

    local stroke = create("UIStroke", { Color = themeCol, Thickness = 2, Parent = sectionFrame })
    if windowRef and windowRef.staticThemeElements then
        table.insert(windowRef.staticThemeElements, {Object = stroke, Property = "Color"})
    end
    
    create("UIListLayout", {
        Parent = sectionFrame,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 3),
        HorizontalAlignment = Enum.HorizontalAlignment.Center
    })
    
    create("UIPadding", {
        Parent = sectionFrame,
        PaddingTop = UDim.new(0, 8),
        PaddingBottom = UDim.new(0, 8),
        PaddingLeft = UDim.new(0, 6),
        PaddingRight = UDim.new(0, 6)
