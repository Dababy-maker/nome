        Font = Enum.Font.GothamBold, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false, ZIndex = 3
    })
    
    local statusLabel = create("TextLabel", {
        Name = "StatusLabel", Parent = mainFrame, Size = UDim2.new(0.5, -12, 0, 18), Position = UDim2.new(0.5, 20, 0, 137),
        BackgroundTransparency = 1, Text = "Waiting for key", TextColor3 = Color3.fromRGB(160, 160, 175),
        Font = Enum.Font.GothamBold, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 2
    })

    local function SetStatus(text, color)
        TweenService:Create(statusLabel, TweenInfo.new(0.2), {TextTransparency = 1}):Play()
        task.wait(0.2)
        statusLabel.Text = text
        statusLabel.TextColor3 = color or Color3.fromRGB(160, 160, 175)
        TweenService:Create(statusLabel, TweenInfo.new(0.2), {TextTransparency = 0}):Play()
    end
    
    local buttonsContainer = create("Frame", {
        Name = "ButtonsContainer", Parent = mainFrame, Size = UDim2.new(1, -48, 0, 44), Position = UDim2.new(0, 24, 0, 180),
        BackgroundTransparency = 1, ZIndex = 2
    })
    create("UIListLayout", {
        Parent = buttonsContainer, FillDirection = Enum.FillDirection.Horizontal,
        HorizontalAlignment = Enum.HorizontalAlignment.Center, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 12)
    })
    
    local getKeyBtn = create("TextButton", {
        Name = "GetKeyButton", Parent = buttonsContainer, Size = UDim2.new(0.5, -6, 1, 0),
        BackgroundColor3 = Color3.fromRGB(45, 45, 55), BackgroundTransparency = 0.1, Text = "", ZIndex = 3, AutoButtonColor = true
    })
    create("UICorner", { CornerRadius = UDim.new(0, 22), Parent = getKeyBtn })
    create("UIGradient", {
        Parent = getKeyBtn, Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0.0, Color3.fromRGB(30, 30, 40)), ColorSequenceKeypoint.new(0.3, Color3.fromRGB(55, 55, 65)),
            ColorSequenceKeypoint.new(0.7, Color3.fromRGB(55, 55, 65)), ColorSequenceKeypoint.new(1.0, Color3.fromRGB(30, 30, 40))
        }), Rotation = 0
    })
    create("TextLabel", {
        Name = "ButtonText", Parent = getKeyBtn, Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
        Text = "🔑  Get Key", TextColor3 = Color3.fromRGB(255, 255, 255), Font = Enum.Font.GothamBold, TextSize = 13, ZIndex = 4
    })
    
    local verifyBtn = create("TextButton", {
        Name = "VerifyKeyButton", Parent = buttonsContainer, Size = UDim2.new(0.5, -6, 1, 0),
        BackgroundColor3 = Color3.fromRGB(42, 150, 48), BackgroundTransparency = 0.1, Text = "", ZIndex = 3, AutoButtonColor = true
    })
    create("UICorner", { CornerRadius = UDim.new(0, 22), Parent = verifyBtn })
    create("UIGradient", {
        Parent = verifyBtn, Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0.0, Color3.fromRGB(20, 75, 25)), ColorSequenceKeypoint.new(0.2, Color3.fromRGB(48, 175, 55)),
            ColorSequenceKeypoint.new(0.8, Color3.fromRGB(48, 175, 55)), ColorSequenceKeypoint.new(1.0, Color3.fromRGB(20, 75, 25))
        }), Rotation = 0
    })
    create("TextLabel", {
        Name = "ButtonText", Parent = verifyBtn, Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
        Text = "✔️ Verify Key", TextColor3 = Color3.fromRGB(255, 255, 255), Font = Enum.Font.GothamBold, TextSize = 13, ZIndex = 4
    })
    
    getKeyBtn.MouseButton1Click:Connect(function()
        local function copyToClipboard(str)
            if setclipboard then setclipboard(str)
            elseif toclipboard then toclipboard(str) end
        end
        pcall(copyToClipboard, discordLink)
        SetStatus("Link copied!", Color3.fromRGB(130, 160, 255))
        task.delay(2, function()
            if statusLabel.Text == "Link copied!" then SetStatus("Waiting for key", Color3.fromRGB(160, 160, 175)) end
        end)
    end)
    
    local isChecking = false
    verifyBtn.MouseButton1Click:Connect(function()
        if isChecking then return end
        isChecking = true
        
        local enteredKey = keyInput.Text
        if enteredKey == "" then
            SetStatus("Please enter a key", Color3.fromRGB(255, 80, 80))
            task.delay(2, function()
                if statusLabel.Text == "Please enter a key" then SetStatus("Waiting for key", Color3.fromRGB(160, 160, 175)) end
            end)
            isChecking = false
            return
        end

        SetStatus("Checking key...", Color3.fromRGB(200, 200, 215))

        local isValid = false
        local validationError = "Key is wrong"

        if scriptId and scriptId ~= "" then
            local modSuccess, module = pcall(function()
                return loadstring(game:HttpGet(apiModuleUrl))()
            end)
            
            if modSuccess and module and module.new then
                local api = module.new(scriptId, apiKey)
                
                local success, result = pcall(function()
                    return api:validate(enteredKey)
                end)
                
                if success then
                    isValid = result 
                    if not isValid then
                        validationError = tostring(result) 
                    end
                else
                    isValid = false
                    validationError = "Validation request failed"
                end
            else
                isValid = false
                validationError = "Failed to load API module"
            end

        elseif type(customVerify) == "function" then
            isValid = customVerify(enteredKey)
            
        elseif type(rawUrl) == "string" and rawUrl ~= "" then
            local requestFunc = syn and syn.request or http and http.request or http_request or fluxus and fluxus.request or getgenv().request or request
            if requestFunc then
                local success, res = pcall(function()
                    return requestFunc({Url = rawUrl, Method = "GET"})
                end)
                if success and res and res.Body then
                    for line in string.gmatch(res.Body, "[^\r\n]+") do
                        if line == enteredKey then
                            isValid = true
                            break
                        end
                    end
                else
                    isValid = false
                    validationError = "Failed to fetch keys"
                end
            else
                isValid = false
                validationError = "Executor doesn't support HTTP"
            end
            
        elseif type(validKeys) == "table" then
            for _, key in ipairs(validKeys) do
                if key == enteredKey then
                    isValid = true
                    break
                end
            end
        else
            isValid = false
            validationError = "No verification method set"
        end

        if isValid then
            SetStatus("Key successful", Color3.fromRGB(80, 230, 100))
            task.wait(1)
            
            TweenService:Create(mainFrame, TweenInfo.new(0.4), {BackgroundTransparency = 1}):Play()
            TweenService:Create(mainStroke, TweenInfo.new(0.4), {Transparency = 1}):Play()
            TweenService:Create(backgroundImage, TweenInfo.new(0.4), {ImageTransparency = 1}):Play()
            task.wait(0.4)
            keyWindowGui:Destroy()
            if onSuccess then onSuccess() end
        else
            SetStatus(validationError, Color3.fromRGB(255, 80, 80))
            task.wait(2)
            SetStatus("Waiting for key", Color3.fromRGB(160, 160, 175))
            isChecking = false
        end
    end)
end

