function RYZA:AddTheme(name, color3)
    RYZA.Themes[name] = color3
    if self and self.themeDropdown then
        local names = {}
        for n in pairs(RYZA.Themes) do table.insert(names, n) end
        table.sort(names)
        self.themeDropdown:Update(names)
    end
end

function RYZA:AddBackground(name, assetId)
    if not string.find(assetId, "rbxassetid://") then
        assetId = "rbxassetid://" .. assetId
    end
    RYZA.Backgrounds[name] = assetId
    if self and self.bgDropdown then
        local names = {"None"}
        local temp = {}
        for n in pairs(RYZA.Backgrounds) do if n ~= "None" then table.insert(temp, n) end end
        table.sort(temp)
        for _, n in ipairs(temp) do table.insert(names, n) end
        self.bgDropdown:Update(names)
    end
end

