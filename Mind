            table.insert(windowRef.openedPopups, {close = function()
                if isOpen then togglePicker(false) end
            end, isColorPicker = true})
        end

        local function setupInput(frame, knob, isHueSlider, callback)
            local inputConnection
            inputConnection = frame.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    sectionFrame.ScrollingEnabled = false
                    local changedConnection, endedConnection
                    local function handleInput(inputObject)
                        local pos = inputObject.Position
                        local absPos = frame.AbsolutePosition
                        local absSize = frame.AbsoluteSize
                        
                        if isHueSlider then 
                            local x = math.clamp((pos.X - absPos.X) / absSize.X, 0, 1)
                            callback(x)
                            knob.Position = UDim2.fromScale(x, 0.5) 
                        else 
                            local maxX = math.max(0, absSize.X - knob.AbsoluteSize.X)
                            local maxY = math.max(0, absSize.Y - knob.AbsoluteSize.Y)
                            local xOffset = math.clamp(pos.X - absPos.X, 0, maxX)
                            local yOffset = math.clamp(pos.Y - absPos.Y, 0, maxY)
                            
                            local newS = (maxX > 0) and (xOffset / maxX) or 0
                            local newV = (maxY > 0) and (1 - (yOffset / maxY)) or 0
                            
                            callback(newS, newV)
                            knob:TweenPosition(UDim2.fromOffset(xOffset, yOffset), Enum.EasingDirection.Out, Enum.EasingStyle.Sine, 0.04, true)
                        end
                        updateWorkingColor()
                    end
                    handleInput(input)
                    changedConnection = UserInputService.InputChanged:Connect(function(inputObject) if inputObject.UserInputType == Enum.UserInputType.MouseMovement or inputObject.UserInputType == Enum.UserInputType.Touch then handleInput(inputObject) end end)
                    endedConnection = UserInputService.InputEnded:Connect(function(inputObject) 
                        if inputObject.UserInputType == Enum.UserInputType.MouseButton1 or inputObject.UserInputType == Enum.UserInputType.Touch then 
                            sectionFrame.ScrollingEnabled = true
                            if changedConnection then changedConnection:Disconnect() end
                            if endedConnection then endedConnection:Disconnect() end 
                        end 
                    end)
                end
            end)
            if windowRef and windowRef.connections then table.insert(windowRef.connections, inputConnection) end
        end
        setupInput(svBox, svKnob, false, function(newS, newV) s, v = newS, newV end)
        setupInput(hueSlider, hueKnob, true, function(newH) h = newH end)

        colorPreview.MouseButton1Click:Connect(function() togglePicker() end)
        cLabel.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                togglePicker()
            end
        end)

        return pf
    end

