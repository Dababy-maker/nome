local function registerLocal(windowRef, element, key, prop)
    prop = prop or "Text"
    if not windowRef then return end
    if not windowRef.LocalizedElements then windowRef.LocalizedElements = {} end
    
    table.insert(windowRef.LocalizedElements, {Element = element, Key = key, Property = prop})
    
    local lang = windowRef.CurrentLanguage or "English"
    if RYZA.Translations[lang] and RYZA.Translations[lang][key] then
        element[prop] = RYZA.Translations[lang][key]
    else
        element[prop] = key
    end
end

